<View>
  <Image name="image" value="$image" zoom="true" zoomControl="true" rotateControl="true" />
  <Header value="病灶分割轮廓" />
  <PolygonLabels name="lesion_polygon" toName="image">
    <Label value="病灶" background="#FBBF24" />
  </PolygonLabels>
  <Choices name="review_status" toName="image" choice="single">
    <Choice value="通过" />
    <Choice value="需要复核" />
    <Choice value="无法判断" />
  </Choices>
  <TextArea name="review_comment" toName="image" placeholder="填写审核意见" />
</View>
