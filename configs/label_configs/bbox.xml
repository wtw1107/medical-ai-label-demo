<View>
  <Image name="image" value="$image" zoom="true" zoomControl="true" rotateControl="true" />
  <Header value="Detection bbox" />
  <RectangleLabels name="bbox" toName="image">
    <Label value="Lesion" background="#21C7C4" />
  </RectangleLabels>
  <Choices name="review_status" toName="image" choice="single">
    <Choice value="Approved" />
    <Choice value="Needs review" />
    <Choice value="Cannot judge" />
  </Choices>
  <TextArea name="review_comment" toName="image" placeholder="Add review notes here" />
</View>
